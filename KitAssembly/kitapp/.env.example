# Generate a unique secret; this placeholder is rejected at startup.
SECRET_KEY=replace-with-your-secret-key
# Local HTTP development. Production: False and explicit public hosts.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
# Secure cookies default to True when DEBUG=False; explicit overrides optional.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# VISITOR_COOKIE_SECURE=True

# Required absolute base URLs; trailing slashes are normalized automatically.
WEBDATABASE_URL=http://127.0.0.1:8000/WebDatabase/
LABDATABASE_URL=http://127.0.0.1:8000/LabDatabase/
# Empty means WEBDATABASE_URL + login.
API_LOGIN_URL=
# Supply deployment-owned credentials; no shared example account is shipped.
API_LOGIN_USERNAME=
API_LOGIN_PASSWORD=
API_LOGIN_USERNAME_FIELD=username
API_LOGIN_PASSWORD_FIELD=password
API_LOGIN_NEXT=
API_REQUEST_TIMEOUT=20
# Optional paths; relative paths resolve against kitapp/.
TUTORIAL_ADDRESS=
ZIP_ADDRESS=
TUTORIAL_SITE_ROOT=site
SQLITE_PATH=db.sqlite3
VISITOR_COOKIE_NAME=kitapp_visitor_id
VISITOR_COOKIE_MAX_AGE=31536000
VISITOR_COOKIE_SAMESITE=Lax

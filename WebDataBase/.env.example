# Django
DJANGO_SECRET_KEY=replace-with-your-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# MySQL
DB_NAME=labdnadata
DB_USER=root
DB_PASSWORD=replace-with-your-db-password
DB_HOST=localhost
DB_PORT=3306

# Services (absolute URLs, no developer-machine IP defaults)
WEBDATABASE_API_BASE_URL=http://127.0.0.1:8000/WebDatabase/
# Optional: set this before using experience detail links.
EXPERIMENT_BASE_URL=
SERVICE_HTTP_TIMEOUT=30

# Optional absolute paths; omit to use media/assembly, media/assembly_inputs,
# media/generated, bundled Excel templates and bundled BasicFeature.txt.
# MEDIA_ROOT=/srv/polaris/media
# ASSEMBLY_OUTPUT_DIR=/srv/polaris/media/assembly
# ASSEMBLY_INPUT_DIR=/srv/polaris/media/assembly_inputs
# GENERATED_FILES_DIR=/srv/polaris/media/generated
# DOWNLOAD_TEMPLATE_DIR=/srv/polaris/templates
# BASIC_FEATURE_FILE=/srv/polaris/BasicFeature.txt
# CUSTOM_SCAR_FILE=/srv/polaris/media/CustomScarInfo.txt
# LOG_DIR=/var/log/polaris

TASK_STATUS_TTL_SECONDS=100000
DB_RETRY_TIMEOUT_SECONDS=5
DB_RETRY_INTERVAL_SECONDS=0.5
# Creation and update/renewal retain their previous, distinct policies.
REPOSITORY_CREATE_TTL_HOURS=720
REPOSITORY_UPDATE_TTL_HOURS=24
DESIGN_REPOSITORY_TTL_HOURS=720
API_PAGE_SIZE=10
API_MAX_PAGE_SIZE=5000
UPLOAD_PAGE_SIZE=100
UPLOAD_MAX_PAGE_SIZE=5000
DESIGN_CANDIDATE_LIMIT=20
# Copy and populate the example. Relative paths resolve against this project.
DESIGN_CONFIG_FILE=WebDataWorld/design_config.example.json
